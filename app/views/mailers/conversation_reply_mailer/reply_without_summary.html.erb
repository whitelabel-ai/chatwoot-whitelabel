<% @messages.each_with_index do |message, index| %>
  <tr>
    <td style="padding: 0; margin: 0;">
      <div style="margin-bottom: 20px; <%= index == 0 ? 'margin-top: 10px;' : '' %>">
        <!-- Message Header -->
        <div style="margin-bottom: 8px;">
          <span style="display: inline-block; padding: 6px 12px; background-color: <%= message.incoming? ? '#e3f2fd' : '#667eea' %>; color: <%= message.incoming? ? '#1976d2' : '#ffffff' %>; border-radius: 15px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
            <%= message.incoming? ? '👤 Tú' : "🎧 #{message.sender&.available_name || message.sender&.name || 'Agente'}" %>
          </span>
          <span style="color: #6c757d; font-size: 12px; margin-left: 10px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
            <%= message.created_at.strftime('%d/%m/%Y %H:%M') %>
          </span>
        </div>
        
        <!-- Message Content -->
        <div style="background: <%= message.incoming? ? 'linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%)' : 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)' %>; padding: 16px 20px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; line-height: 1.5;">
          <% if message.content.present? %>
            <div style="color: <%= message.incoming? ? '#495057' : '#ffffff' %>; font-size: 15px;">
              <%= ChatwootMarkdownRenderer.new(message.content).render_message %>
            </div>
          <% end %>
          
          <% if message.attachments.present? %>
            <div style="margin-top: 15px; padding-top: 15px; border-top: 1px solid <%= message.incoming? ? '#dee2e6' : 'rgba(255, 255, 255, 0.3)' %>;">
              <p style="margin: 0 0 10px 0; color: <%= message.incoming? ? '#6c757d' : 'rgba(255, 255, 255, 0.9)' %>; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">
                📎 Archivos adjuntos:
              </p>
              <% message.attachments.each_with_index do |attachment, attachment_index| %>
                <div style="<%= attachment_index > 0 ? 'margin-top: 8px;' : '' %>">
                  <a href="<%= attachment.file_url %>" target="_blank" style="display: inline-block; background-color: <%= message.incoming? ? '#ffffff' : 'rgba(255, 255, 255, 0.2)' %>; color: <%= message.incoming? ? '#667eea' : '#ffffff' %>; padding: 8px 12px; border-radius: 6px; text-decoration: none; font-size: 13px; font-weight: 500; border: 1px solid <%= message.incoming? ? '#dee2e6' : 'rgba(255, 255, 255, 0.3)' %>;">
                    📄 <%= attachment.file.filename.to_s %>
                  </a>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </td>
  </tr>
<% end %>
